NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas – required
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/shetimitra?retryWrites=true&w=majority

# JWT – required in production
JWT_SECRET=change_me_to_a_random_256_bit_secret
JWT_EXPIRES_IN=7d

# Cloudinary – optional (image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenWeatherMap – optional
WEATHER_API_KEY=

# Gemini AI – optional (real inference)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
